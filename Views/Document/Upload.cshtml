@model SElab5.Models.Document
@{
    ViewData["Title"] = "Upload Document";
}

<div class="auth-container">
    <div class="glass-card" style="max-width: 500px; width: 100%;">
        <h3>Upload to Archive</h3>
        <p class="text-muted small mb-4">Files are stored securely in our centralized repository.</p>

        <form asp-action="Upload" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="All" class="text-danger small mb-3"></div>
            <div class="form-group">
                <label>Select File</label>
                <input type="file" name="file" class="form-control" />
            </div>
            <div class="form-group">
                <label>Category</label>
                <select asp-for="Category" class="form-control">
                    <option>Identity Documents</option>
                    <option>Property Deeds</option>
                    <option>Tax Certificates</option>
                    <option>Other</option>
                </select>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary-custom flex-grow-1">Start Upload</button>
                <a asp-action="Index" class="btn btn-outline-light">Back</a>
            </div>
        </form>
    </div>
</div>

