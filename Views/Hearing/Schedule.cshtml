@model SElab5.Models.Hearing
@{
    ViewData["Title"] = "Book Hearing";
}

<div class="auth-container">
    <div class="glass-card" style="max-width: 500px; width: 100%;">
        <h3>Request an Audience</h3>
        <p class="text-muted small mb-4">Select a topic and preferred date for your online hearing.</p>

        <form asp-action="Schedule" method="post">
            <div asp-validation-summary="All" class="text-danger small mb-3"></div>
            <div class="form-group">
                <label>Hearing Subject</label>
                <input asp-for="Title" class="form-control" placeholder="e.g. Zoning Inquiry" />
            </div>
            <div class="form-group">
                <label>Preferred Date</label>
                <input asp-for="ScheduledDate" type="datetime-local" class="form-control" />
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary-custom flex-grow-1">Schedule Now</button>
                <a asp-action="Index" class="btn btn-outline-light">Cancel</a>
            </div>
        </form>
    </div>
</div>

